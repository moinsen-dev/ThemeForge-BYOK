---
import "@/styles/global.css";

interface Props {
  title?: string;
}

const { title = "ThemeForge BYOK" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Generate design systems from a short description. Bring your own OpenAI API key." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950 text-neutral-200 antialiased">
    <slot />
  </body>
</html>
